{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NTOPIA",
  "version": "0.0.2",
  "identifier": "app.ntopia",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NTOPIA",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0NDFEODc3Q0QxRkYyMjYKUldRbThoL05kOWhCSkRZVXdBa1JEeGxHM0RVUHo5VkpKb2wwNEpnNHYybzF0NkFDRGlhaW5Pb0EK",
      "endpoints": [
        "https://github.com/cyborgoat/ntopia/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
